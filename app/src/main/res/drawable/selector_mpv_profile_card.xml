<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/theme_green_surface" />
            <corners android:radius="10dp" />
            <stroke android:width="2dp" android:color="@color/theme_green_dark" />
        </shape>
    </item>
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/theme_green_surface" />
            <corners android:radius="10dp" />
            <stroke android:width="2dp" android:color="@color/theme_green_dark" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/theme_green_light" />
            <corners android:radius="10dp" />
            <stroke android:width="1dp" android:color="@color/theme_green_dark" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#FAFBFC" />
            <corners android:radius="10dp" />
            <stroke android:width="1dp" android:color="#E1E5EA" />
        </shape>
    </item>
</selector>
